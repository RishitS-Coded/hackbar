# Core packages. Every name here MUST exist in Debian trixie or the build fails.
# Add or remove lines to change what is on the ISO. (Security tools live in
# config/hooks/live/0200-hackbar-tools.hook.chroot so a missing tool can't break the build.)

# Desktop
task-xfce-desktop
lightdm
lightdm-gtk-greeter
xfce4-terminal
firefox-esr
gnome-themes-extra
adwaita-icon-theme
fonts-dejavu
zenity
xdg-utils

# Needed by HackBar and its first-boot setup
python3
python3-pip
python3-venv
python3-tk
git
curl
wget
nano
vim
sudo
unzip
zip
ca-certificates

# Networking basics
network-manager
network-manager-gnome
net-tools
iproute2
dnsutils
traceroute
whois
openssh-client
netcat-openbsd
tcpdump
nmap

# macOS-style look: dock, panel plugins, fallback themes and icons
plank
thunar
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
xfce4-power-manager-plugins
arc-theme
papirus-icon-theme

# Live-session support
live-boot
live-config

# macOS-style top bar
xfce4-whiskermenu-plugin
xfce4-pulseaudio-plugin
dconf-cli
